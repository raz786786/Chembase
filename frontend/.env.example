# ChemBase Pro — Frontend Environment Template
# Copy this file to .env.local (never commit .env.local)

# ── Supabase (required) ──────────────────────────────
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_new_rotated_anon_key_here

# ── Backend API (optional — falls back to /api via vercel.json rewrite) ──
# Local dev: backend on http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ── AI provider keys (existing feature) ──────────────
VITE_NOVA_API_KEY=your_amazon_nova_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_key_here
VITE_GROQ_API_KEY=your_groq_key_here
VITE_MATERIALS_API_KEY=your_materials_project_key_here
