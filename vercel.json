{
  "buildCommand": "cd frontend && npm install && npx tsc -b && npx vite build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://chembase-api-uvel.onrender.com/api/$1" },
    { "source": "/((?!assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
