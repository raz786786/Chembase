# ChemBase Backend — Environment Template
# Copy to .env on Render (or set env vars in the dashboard). Never commit the real file.

# ── Database ─────────────────────────────────────────
# Local dev (default): leave unset → SQLite at backend/chembase.db
# Supabase: Dashboard → Connect → Session pooler string, e.g.:
# postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── Supabase service key (backend ONLY — never expose to frontend) ──
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=

# ── Device auth: comma-separated device_id:sha256(secret) pairs ──
# The seeded dev secrets (dev-secret-drone-01/02) work for local testing.
DEVICE_CREDENTIALS=Drone_01:839d51042c3aee2de25d545f0449afe52b5080a3e0b24f01c9b7e5502e379b17,Drone_02:8791edc9620c99c2b4fc59c6fcb4eebb36c6136339534d3d93db1c325d754915

# ── CORS (comma-separated origins; * only for local dev) ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5800,http://localhost:3000

# ── Supabase Storage (OTA) ───────────────────────────
SUPABASE_URL=
SUPABASE_BUCKET=tinyml-models
